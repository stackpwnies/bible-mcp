{
  "name": "bible-json-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for querying Bible versions, books, chapters, and verses from the Bible-json dataset",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "bible-mcp": "bin/bible-mcp"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile bin/bible-mcp --target bun",
    "inspector": "bunx @modelcontextprotocol/inspector bun run src/index.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.28"
  }
}
